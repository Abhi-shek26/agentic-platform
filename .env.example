# Database
DATABASE_URL=postgresql://agentic:agentic123@localhost:5432/agentic_platform_dev

# Redis
REDIS_URL=redis://localhost:6379

# Azure
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_CONTAINER_REGISTRY_URL=

# (legacy, unused)
GEMINI_API_KEY=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Session
SESSION_SECRET=your-super-secret-key-change-in-production

# AI / Claude (fallback)
ANTHROPIC_API_KEY=

# AI / Qubrid (preferred, cheap OpenAI-compatible)
# Get key at https://platform.qubrid.com/api-keys
QUBRID_API_KEY=
QUBRID_BASE_URL=https://platform.qubrid.com/v1
QUBRID_MODEL=deepseek-ai/DeepSeek-V4-Flash
QUBRID_CODE_MODEL=Qwen/Qwen3-Coder-Flash
# Optional cap (tokens) for the default planning-model calls; per-agent
# maxTokens overrides still apply. Prevents runaway completion spend.
QUBRID_MAX_TOKENS=

# Generation behaviour
# MOCK_AGENTS=true = free pipeline test (no LLM calls); false = real generation
MOCK_AGENTS=true
# Frontend retry fires when emitted pages fall below this (1 retry max)
FRONTEND_MIN_PAGES=3

# Honest preview cache: rebuild artifacts older than this (days) are pruned
# on boot. 0 disables pruning. Sources are never deleted.
PREVIEW_CACHE_DAYS=14

# Vercel one-click deploy (optional — or paste per-deploy in UI)
VERCEL_TOKEN=

# Server
PORT=5000
NODE_ENV=development
VITE_API_URL=http://localhost:5000
